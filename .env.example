NODE_ENV=development
PORT=7010
APP_VERSION=1.0.0
TRUST_PROXY=false

DATABASE_URL=postgres://homing:homing@localhost:54329/homing_dev
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:63799/0
QUEUE_PREFIX=homing

CORS_ORIGINS=http://localhost:7011
PUBLIC_API_URL=http://localhost:7010
CONSOLE_URL=http://localhost:7011
INVITE_TTL_DAYS=7

SECRET_PEPPER=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32
BCRYPT_ROUNDS=12
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
BODY_LIMIT=2mb

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10

PAIRING_CODE_TTL_SECONDS=600
LEASE_SECONDS=120
MAX_LEASE_ATTEMPTS=3
HEARTBEAT_INTERVAL_SECONDS=60
PULL_INTERVAL_SECONDS=300
OFFLINE_AFTER_SECONDS=180
STALE_HEARTBEAT_SECONDS=120
LOW_BATTERY_PERCENT=15
MAINTENANCE_INTERVAL_MS=5000
OPT_OUT_KEYWORDS=STOP,STOPALL,UNSUBSCRIBE,CANCEL,END,QUIT

WEBHOOK_WORKER_ENABLED=true
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_MS=60000
WEBHOOK_ALLOW_HTTP=true
WEBHOOK_ALLOW_PRIVATE_TARGETS=true
WEBHOOK_OUTBOX_INTERVAL_MS=1000
WEBHOOK_OUTBOX_BATCH=100

FIREBASE_SERVICE_ACCOUNT_BASE64=
OPENAPI_SPEC_PATH=packages/contracts/openapi/public.yaml
