{
  "name": "@homing/cloud",
  "version": "1.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:migrate": "node dist/database/migrate.js && node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest --maxWorkers=2",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "contracts:lint": "pnpm --filter @homing/contracts lint",
    "contracts:generate": "pnpm --filter @homing/contracts generate"
  },
  "license": "UNLICENSED",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.7.0",
      "onFail": "download"
    }
  },
  "private": true,
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/throttler": "^6.7.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.7.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nanoid": "^3.3.20",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@homing/contracts": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.9",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
